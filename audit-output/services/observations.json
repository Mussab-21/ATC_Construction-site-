      "title": "Civil & Infrastructure",
      "description": "Heavy foundations, reinforced concrete frames, earthworks, arterial roads, drainage networks, and boundary structures.",
      "href": "services.html#civil"
    },
    {
      "title": "Electrical, Power & Mechanical",
      "description": "MV/LV power substations, transformers, switchgear networks, industrial HVAC chiller plants, and specialized piping.",
      "href": "services.html#electrical"
    },
    {
      "title": "Finishing Works",
      "description": "Scratch-to-completion interior fit-outs, executive joinery, acoustic ceilings, curtain walls, and premium facade installations.",
      "href": "services.html#finishing"
    },
    {
      "title": "Security, Smart & IT",
      "description": "Biometric access control, enterprise CCTV surveillance, fire alarm detection, building management systems (BMS), and fiber networks.",
      "href": "services.html#security"
    },
    {
      "title": "Defense & Operations",
      "description": "Fortified military base infrastructure, mission-critical power resilience, 24/7 technical O&M, and facility maintenance contracts.",
      "href": "services.html#defense"
    },
    {
      "title": "Oil, Gas & Petroleum",
      "description": "Refineries, fuel retail stations, storage tanks, high-pressure piping, and hazardous-area safety systems.",
